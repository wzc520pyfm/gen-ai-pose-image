{
  "name": "dsh-pose-muse",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 姿势参考生图插件。从 ai-pose-gallery-zh 选择一个或多个姿势，默认模特是原创的 DeepSeek 娘化形象澜，也可以导入其他模特。",
  "type": "module",
  "main": "./plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "shared",
    "data/catalog.json",
    "public/muse",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots"],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.5"
  },
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p 43123",
    "build": "next build --turbopack",
    "start": "next start -H 0.0.0.0 -p 43123",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test shared/pose.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
