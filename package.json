{
  "name": "gen-ai-pose-image",
  "version": "0.1.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzc520pyfm/gen-ai-pose-image.git"
  },
  "description": "澜姿：从姿势线稿和衣装集给社区鲸鱼娘大肥鱼出图，也可装进 DeepSeek Harness。Lanpose generates images of the community whale-girl Dafeiyu from pose sketches and costumes, and installs into DeepSeek Harness.",
  "type": "module",
  "main": "./plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "shared",
    "data/catalog.json",
    "data/costumes.json",
    "public/muse",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.5"
  },
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p 43123",
    "build": "next build --turbopack",
    "start": "next start -H 0.0.0.0 -p 43123",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:client": "node scripts/build-client.mjs",
    "test": "npm run build:client && node --test shared/pose.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
